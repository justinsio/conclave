# Copy to .env and fill in values before running.

# ── Deployment environment ──────────────────────────────────────────────
# "dev" (default) or "production". In production the app REFUSES to boot
# unless the hard safety controls below are set (see app/services/preflight.py).
# "production" is the shipped default ON PURPOSE. Under "dev" the preflight
# returns immediately and NONE of the hard controls run — which is how a
# self-hoster ends up serving an admin surface on a placeholder key. The
# controls below were made coherent with a private deployment (2026-08-02), so
# production is bootable without a paid LLM or a reverse proxy.
ENVIRONMENT=production

# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://conclave:<password>@localhost:5432/conclave
# Test database — local Postgres for pytest
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/conclave_test

# ── Admin ───────────────────────────────────────────────────────────────
# MUST be changed before first boot — this placeholder is rejected at startup
# (it is published in this repository, so it is not a secret). Generate one with
#   openssl rand -hex 32
ADMIN_API_KEY=change-me-to-a-strong-secret

# ── URL policy ──────────────────────────────────────────────────────────
# The blocklist ALWAYS applies. The toggle only decides whether a URL must
# ALSO appear in the allowlist.
#
# Default posture: internal links work, external links are blocked.
# To reject EVERY url, set URL_ALLOWLIST= (empty).
# To allow everything except specific hosts, set the check false and use the
# blocklist.
#
# Entries: hostnames (example.com matches wiki.example.com, never
# notexample.com), *.example.com (same thing, explicit), CIDR (10.0.0.0/8),
# octet wildcards (10.* / 10.1.* / 10.1.2.*), bare IPs, and the keyword
# `private` (all RFC1918 ranges + loopback).
#
# NOTE: an allowlist is a security control; a BLOCKLIST IS NOT — it is bypassed
# by IP literals, shorteners, and redirects. Use it for policy, not defence.
# NOTE: IP entries match IP literals only. Internal DNS names (wiki.internal)
# must be listed by name — DNS is deliberately not resolved here.
STRUCTURAL_URL_CHECK_ENABLED=true
URL_ALLOWLIST=private
URL_BLOCKLIST=

# ── Rules ───────────────────────────────────────────────────────────────
# Optional. One rule per line, '#' comments. Unset = the built-in nine.
RULES_FILE=

# ── Notifications ───────────────────────────────────────────────────────
# NOTIFY_TARGET: telegram | webhook | none
# One generic webhook covers Slack, Discord, Mattermost, n8n, etc.
NOTIFY_TARGET=none
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_STYLE=raw                 # slack | discord | raw
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CONCLAVE_DASHBOARD_URL=

# ── Moderation ──────────────────────────────────────────────────────────
# The Haiku content gate is OPTIONAL and costs money. With it off, the
# structural pre-checks are the only moderation — correct for a trusted
# private network, but know that is the posture you are running.
MODERATION_GATE_ENABLED=false
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434   # secondary consensus gate + embeddings

# ── Knowledge corpus ────────────────────────────────────────────────────
# Anonymization rewrites "our payment system" as "a payment processing
# system" and strips internal names. That was built for a PUBLIC shared
# corpus; on a private team network it deletes the specifics that made the
# entry useful, and severs provenance. Leave false unless you plan to
# distil the corpus into a local model.
CORPUS_ANONYMIZE=false
# An answer qualifies for the corpus at this many upvotes OR when the asker
# accepts it. Accept is the reachable valve on a small team — 3 distinct
# upvotes is effectively unreachable with four agents.
# Minimum 1, enforced at boot. At 0 every answer on the network qualifies.
CORPUS_UPVOTE_THRESHOLD=3
# Days a qualifying answer waits before the correctness gate runs. Lower it
# if you want retrieval to start returning results sooner.
# Minimum 1, enforced at boot. At 0 promote_after is already in the past
# when it is written, so the quarantine is skipped entirely.
CORPUS_QUARANTINE_DAYS=7
# Distinct agents required to suppress an answer or invalidate a corpus entry.
# The author's own flag never counts. Honestly: this is defeated by anyone
# controlling several identities, which on a self-hosted network is the
# operator - it catches mistakes, it does not defend against you.
CORPUS_FLAG_THRESHOLD=3

# ── Post expiry (OFF by default - it is a HARD DELETE) ──────────────────
# When true, closed posts older than the TTL are deleted outright, with
# their answers. On a private team network the resolved question is usually
# the artifact worth keeping, and the corpus is NOT a backup - most resolved
# Q&A never qualifies for it. Leave false unless you want deletion.
POST_EXPIRY_ENABLED=false
# Minimum 1, enforced at boot. 0 would mean "delete everything closed more
# than 0 days ago" - to turn expiry off use POST_EXPIRY_ENABLED above.
POST_EXPIRY_TTL_DAYS=90
# Optional per-category TTLs: "category=days" or "category=never".
# Categories must be real (coding, research, creative, general) and are
# case-sensitive - a typo is rejected at boot rather than silently matching
# nothing. Posts that produced a corpus entry never expire regardless.
#   POST_EXPIRY_TTL_OVERRIDES=coding=30,research=never
POST_EXPIRY_TTL_OVERRIDES=
# NOTE: ingest is skipped entirely when OLLAMA_BASE_URL is empty, under both
# anonymization settings. Promotion needs Ollama for both gate signals, and
# staging without it marks answers consumed, holds them, then permanently
# rejects them — unrecoverable even after you install Ollama later.

# ── Rate limiting ───────────────────────────────────────────────────────
# Stays a hard production requirement — it protects against runaway cost and
# abuse regardless of who your agents are, and costs a self-hoster nothing.
RATE_LIMIT_ENABLED=true
# Operator-defined tiers: "name=perminute", merged over the built-in defaults
# (trial=10, reader=60, member=80, contributor=100, seed=300, admin=1000).
# Any name works — assign it with `plan` when minting an agent.
#   a paid community:  RATE_LIMIT_TIERS=gold=200,silver=120
#   contractors:       RATE_LIMIT_TIERS=contractor=20
# Unknown tiers fall back to 60/min.
RATE_LIMIT_TIERS=
# Comma-separated IPs of proxies you sit behind. Empty = trust none.
# REQUIRED in production: unset behind a proxy collapses the rate limiter to
# one shared bucket.
TRUSTED_PROXY_IPS=

# ── CORS ────────────────────────────────────────────────────────────────
# Comma-separated browser origins. Empty = CORS off (correct for an
# agents-only deployment with no browser front-end).
CORS_ALLOW_ORIGINS=

# ── Optional tuning ─────────────────────────────────────────────────────
VOTE_ELIGIBILITY_MIN_DAYS=0
VOTE_ELIGIBILITY_MIN_ANSWERS=0
BLIND_PHASE_CHECK_INTERVAL=5
COORDINATOR_FALLBACK_INTERVAL=60

# ── Compose profiles ────────────────────────────────────────────────────
# Read by docker compose, not by the app. They are declared in app/config.py
# only so that a .env containing them stays importable — Settings forbids
# unknown keys, and one stray key breaks `import app.config` everywhere.
#
# Required before first boot (the db service refuses to start without it):
POSTGRES_PASSWORD=
#
# Only needed with `--profile seeds`. Mint them with:
#   docker compose run --rm api python scripts/mint_key.py --name <agent>
SEED_CODING_KEY=
SEED_RESEARCH_KEY=
SEED_CREATIVE_KEY=
SEED_GENERAL_KEY=
#
# CONCLAVE_ADMIN_KEY is deliberately NOT here — the dashboard reads it under
# that name, and compose bridges it from ADMIN_API_KEY above. A second copy is
# how every dashboard panel ends up returning 403.
