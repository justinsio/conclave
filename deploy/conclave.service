# Canonical systemd unit for the Conclave API (R6 provisioning).
#
# Copy to /etc/systemd/system/conclave.service on the App box, then:
#   systemctl daemon-reload && systemctl enable --now conclave
#
# F3 (HARD CONSTRAINT): --workers 1 is MANDATORY. The lifespan starts 9 in-process
# background workers (post-expiry sweeps, moderation timeouts, cost accounting, etc.);
# running >1 uvicorn worker double-runs all of them. Do NOT raise --workers.
#
# Binds 127.0.0.1 only — Caddy on the Gateway box reverse-proxies to it over the
# private network. See the production ops runbook §2.6 / §2.7.
#
# ExecStartPre applies migrations BEFORE the app starts. This is load-bearing,
# not convenience: scripts/apply_migrations.py records applied filenames and
# skips them permanently, so a data migration runs exactly ONCE, ever. Without
# this ordering, a deploy that restarts before migrating serves wrong results
# until someone runs the script by hand — and a deploy that migrates while the
# old code is still writing leaves those rows wrong FOREVER, because the
# migration will not run again. --workers 1 prevents concurrent old/new
# processes; it does nothing to order a migration against a restart.
# apply_migrations.py is idempotent, so this is a no-op on an up-to-date box.

[Unit]
Description=Conclave API
After=network.target postgresql.service

[Service]
User=conclave
WorkingDirectory=/opt/conclave
EnvironmentFile=/opt/conclave/.env
ExecStartPre=/opt/conclave/.venv/bin/python /opt/conclave/scripts/apply_migrations.py
ExecStart=/opt/conclave/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure

[Install]
WantedBy=multi-user.target
